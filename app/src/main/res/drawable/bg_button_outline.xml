<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_fill_raised" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#1A0D0716"
                android:centerColor="#220D0716"
                android:endColor="#338B5CF6"
                android:type="linear" />
            <stroke android:width="1.2dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
